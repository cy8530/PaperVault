OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=your-api-key

# Primary model — note generation, RAG answers (quality-focused)
MODEL_ID=deepseek-ai/DeepSeek-V4-Flash
# Lightweight model — metadata extraction, RAG judge, section matching (speed-focused)
# Falls back to MODEL_ID if not set
LIGHT_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# Embedding model — local, zero API cost (first run downloads ~500MB)
# multilingual-e5-base: multilingual (Chinese + English), 768-dim, balanced speed/quality
# Alternatives:
#   "intfloat/multilingual-e5-small" (384-dim, 200MB, fastest)
#   "BAAI/bge-m3" (1024-dim, 1.5GB, best quality, slower)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

